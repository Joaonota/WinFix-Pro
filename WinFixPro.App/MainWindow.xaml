<Window x:Class="WinFixPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFix Pro" Height="900" Width="1450" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WINFIX PRO" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Windows Diagnostic &amp; Repair Toolkit" FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,20"/>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="NavigationItems"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                        CornerRadius="9" Padding="11" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="COMPUTER" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="ComputerNameText" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PrivilegeText" Foreground="#F59E0B" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock x:Name="EngineText" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageDescription" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Ready"
                           Foreground="#60A5FA" VerticalAlignment="Center"/>
            </DockPanel>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="HEALTH SCORE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock x:Name="HealthText" Text="--" FontSize="24" FontWeight="Bold" Foreground="#22C55E"/></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock x:Name="CpuText" Text="--" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="13" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock x:Name="MemoryText" Text="--" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="13">
                    <StackPanel><TextBlock Text="SYSTEM DRIVE FREE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock x:Name="DiskText" Text="--" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Symptoms, search terms or case notes (optional; do not enter passwords or tokens)"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                    <TextBox x:Name="InputText" Margin="0,6,0,0" MinHeight="34" MaxHeight="90"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#0B1120" Foreground="#F8FAFC" BorderBrush="#263449" Padding="8"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="OPERATIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ProgressBar x:Name="OperationProgress" Width="160" Height="8" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="CancelButton" Content="Cancel" Width="80" Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ActionPanel"/>
                            </ScrollViewer>
                        </Border>
                        <TextBox x:Name="ResultText" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" Background="#0B1120"
                                 Foreground="#CBD5E1" BorderBrush="#263449" Padding="12"/>
                    </Grid>
                </Grid>
            </Border>
            <DockPanel Grid.Row="4" Margin="2,10,2,0">
                <TextBlock x:Name="FooterText" Text="Local diagnostics | No telemetry"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                <TextBlock Text="WinFix Pro 0.2.0" DockPanel.Dock="Right"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
